package-as: RainonUI

manual-changelog:
  filename: Changelog.md
  markup-type: markdown

externals:
  Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
    tag: 1.0
  Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibSharedMedia-3.0:
    url: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  Libs/LibEditMode:
    url: https://github.com/p3lim-wow/LibEditMode
  Libs/LibKeystone: https://github.com/BigWigsMods/LibKeystone.git/LibKeystone

enable-nolib-creation: no

ignore:
  - README.md
  - .gitignore
  - check.js
  - Архив
  - _to_delete
  - CharCheck.lua
  - .claude
  - .codex
  - .agents
  - AGENTS.md
  - .gitattributes
  - CLAUDE.md
  - Media/Icons/README.txt
  - Media/Sounds/README.txt
  - OrderQueueLocal.lua
